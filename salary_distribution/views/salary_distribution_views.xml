<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="salary_distribution_view_form" model="ir.ui.view">
        <field name="name">salary.distribution.form</field>
        <field name="model">salary.distribution</field>
        <field name="arch" type="xml">
            <form string="Salary Distribution">
                <header>
                    <button name="action_compute" string="Compute" type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_compute" string="Recompute" type="object"
                            invisible="state != 'computed'"/>
                    <button name="action_validate" string="Validate" type="object" class="oe_highlight"
                            invisible="state != 'computed'"/>
                    <button name="action_export_xlsx" string="Export Excel" type="object" icon="fa-file-excel-o"
                            invisible="state == 'draft'"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                            invisible="state == 'draft'" confirm="All computed lines will be removed. Continue?"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,computed,validated"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box" invisible="state == 'draft'">
                        <button name="action_open_analysis" type="object" class="oe_stat_button" icon="fa-table">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Analysis</span>
                                <span class="o_stat_text">Pivot / Graph</span>
                            </div>
                        </button>
                        <button name="action_open_journal_lines" type="object" class="oe_stat_button" icon="fa-book">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Journal</span>
                                <span class="o_stat_text">Lines</span>
                            </div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Validated" bg_color="text-bg-success" invisible="state != 'validated'"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Salary Distribution - October 2026" readonly="state == 'validated'"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="batch_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                            <label for="date_start" string="Period" invisible="not batch_id"/>
                            <div class="o_row" invisible="not batch_id">
                                <field name="date_start"/> - <field name="date_end"/>
                            </div>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="employee_count" invisible="state == 'draft'"/>
                            <field name="total_earning" invisible="state == 'draft'"/>
                            <field name="total_deduction" invisible="state == 'draft'"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="status" invisible="state != 'draft'">
                        <i class="fa fa-info-circle"/> Select a payslip batch and click <b>Compute</b> to split each
                        salary rule between departments, using the <b>Salary Distribution</b> tab of every employee.
                    </div>
                    <notebook invisible="state == 'draft'">
                        <page name="summary" string="Summary">
                            <field name="summary_html" nolabel="1" readonly="1"/>
                        </page>
                        <page name="journal" string="Journal Entries">
                            <field name="journal_html" nolabel="1" readonly="1"/>
                        </page>
                        <page name="details" string="Employee Details">
                            <field name="line_ids" readonly="1">
                                <tree decoration-info="is_reallocated">
                                    <field name="employee_id" widget="many2one_avatar_employee"/>
                                    <field name="home_department_id"/>
                                    <field name="department_id"/>
                                    <field name="salary_rule_id"/>
                                    <field name="dist_type" widget="badge"
                                           decoration-success="dist_type == 'earning'" decoration-danger="dist_type == 'deduction'"/>
                                    <field name="percentage"/>
                                    <field name="is_reallocated" column_invisible="True"/>
                                    <field name="amount"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </tree>
                            </field>
                        </page>
                        <page name="note" string="Notes">
                            <field name="note" placeholder="Internal notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="salary_distribution_view_tree" model="ir.ui.view">
        <field name="name">salary.distribution.tree</field>
        <field name="model">salary.distribution</field>
        <field name="arch" type="xml">
            <tree decoration-muted="state == 'draft'">
                <field name="name"/>
                <field name="batch_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="state" widget="badge" decoration-info="state == 'computed'" decoration-success="state == 'validated'"/>
            </tree>
        </field>
    </record>

    <record id="salary_distribution_view_kanban" model="ir.ui.view">
        <field name="name">salary.distribution.kanban</field>
        <field name="model">salary.distribution</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="d-flex justify-content-between">
                                <strong><field name="name"/></strong>
                                <field name="state" widget="label_selection"
                                       options="{'classes': {'draft': 'default', 'computed': 'info', 'validated': 'success'}}"/>
                            </div>
                            <div class="text-muted"><field name="batch_id"/></div>
                            <div><field name="date_start"/> - <field name="date_end"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="salary_distribution_view_search" model="ir.ui.view">
        <field name="name">salary.distribution.search</field>
        <field name="model">salary.distribution</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="batch_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="computed" string="Computed" domain="[('state', '=', 'computed')]"/>
                <filter name="validated" string="Validated" domain="[('state', '=', 'validated')]"/>
                <separator/>
                <filter name="period" string="Period" date="date_end"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_period" string="Period" context="{'group_by': 'date_end:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_salary_distribution" model="ir.actions.act_window">
        <field name="name">Distributions</field>
        <field name="res_model">salary.distribution</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="search_view_id" ref="salary_distribution_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first salary distribution</p>
            <p>Select a payslip batch to split salaries, allowances and deductions between departments
                and get the journal entries of each salary rule.</p>
        </field>
    </record>
</odoo>
