<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="hr_salary_rule_form_salary_distribution" model="ir.ui.view">
        <field name="name">hr.salary.rule.form.salary.distribution</field>
        <field name="model">hr.salary.rule</field>
        <field name="inherit_id" ref="hr_payroll.hr_salary_rule_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="salary_distribution" string="Distribution">
                    <group>
                        <group>
                            <field name="dist_include" widget="boolean_toggle"/>
                            <field name="dist_type" invisible="not dist_include"/>
                        </group>
                        <group invisible="not dist_include" string="Default Account (all departments)">
                            <field name="dist_gl_code" placeholder="e.g. 601110"/>
                            <field name="dist_sys_code" placeholder="e.g. _SYS00000002427"/>
                        </group>
                    </group>
                    <div class="text-muted" invisible="dist_include">
                        This salary rule is not distributed and gets no journal entry.
                    </div>
                    <div invisible="not dist_include">
                        <separator string="Department Exceptions"/>
                        <p class="text-muted">
                            Only for departments that use another account for this rule
                            (e.g. a sister company recharge). Every other department uses the default account.
                        </p>
                        <field name="dist_department_account_ids">
                            <tree editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="department_id" options="{'no_create': True}"/>
                                <field name="sys_code" placeholder="e.g. _SYS00000002295"/>
                                <field name="gl_code" placeholder="e.g. 105618"/>
                            </tree>
                        </field>
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <record id="hr_salary_rule_tree_salary_distribution" model="ir.ui.view">
        <field name="name">hr.salary.rule.tree.salary.distribution</field>
        <field name="model">hr.salary.rule</field>
        <field name="mode">primary</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <tree editable="bottom" create="0" open_form_view="True" default_order="struct_id, sequence"
                  decoration-muted="not dist_include">
                <field name="struct_id" readonly="1"/>
                <field name="sequence" readonly="1" optional="hide"/>
                <field name="name" readonly="1"/>
                <field name="code" readonly="1"/>
                <field name="category_id" readonly="1"/>
                <field name="dist_include" widget="boolean_toggle" string="Include"/>
                <field name="dist_type" readonly="not dist_include"/>
                <field name="dist_gl_code" readonly="not dist_include"/>
                <field name="dist_sys_code" readonly="not dist_include"/>
                <field name="dist_department_account_ids" string="Exceptions" widget="many2many_tags" readonly="1" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="action_salary_rule_distribution" model="ir.actions.act_window">
        <field name="name">Salary Rule Accounts</field>
        <field name="res_model">hr.salary.rule</field>
        <field name="view_mode">tree,form</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'tree', 'view_id': ref('hr_salary_rule_tree_salary_distribution')})]"/>
        <field name="context">{'group_by': 'struct_id'}</field>
    </record>

    <record id="hr_payroll_structure_form_salary_distribution" model="ir.ui.view">
        <field name="name">hr.payroll.structure.form.salary.distribution</field>
        <field name="model">hr.payroll.structure</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_employee_grade_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='salary_details']" position="inside">
                <field name="dist_payable_gl_code" placeholder="e.g. 205410"/>
                <field name="dist_payable_sys_code" placeholder="e.g. _SYS00000002354"/>
                <field name="dist_payable_gl_name" placeholder="e.g. Staff Salary Payable"/>
                <field name="dist_payable_project_code"/>
                <field name="dist_payable_sbu_code"/>
            </xpath>
        </field>
    </record>

    <record id="hr_payroll_structure_tree_salary_distribution" model="ir.ui.view">
        <field name="name">hr.payroll.structure.tree.salary.distribution</field>
        <field name="model">hr.payroll.structure</field>
        <field name="mode">primary</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <tree editable="bottom" create="0">
                <field name="name" readonly="1"/>
                <field name="dist_payable_gl_code"/>
                <field name="dist_payable_sys_code"/>
                <field name="dist_payable_gl_name"/>
                <field name="dist_payable_project_code"/>
                <field name="dist_payable_sbu_code"/>
            </tree>
        </field>
    </record>

    <record id="action_payroll_structure_distribution" model="ir.actions.act_window">
        <field name="name">Payable Accounts</field>
        <field name="res_model">hr.payroll.structure</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="hr_payroll_structure_tree_salary_distribution"/>
    </record>
</odoo>
